    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)/BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="CardDatabase.DataAccess">
      <HintPath>$(GameManagedDir)/CardDatabase.DataAccess.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="SharedLogicUtils">
      <HintPath>$(GameManagedDir)/SharedLogicUtils.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TPCI.RainierClient">
      <HintPath>$(GameManagedDir)/TPCI.RainierClient.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TPCIAssetBundleSystem">
      <HintPath>$(GameManagedDir)/TPCIAssetBundleSystem.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="TPCIBuildtoolsRuntime">
